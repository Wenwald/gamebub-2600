# --- Reference checkouts (read-only, not ours) ---
ref/

# --- ROMs, BIOS, game data: never committed (hard rule) ---
# Synthetic test ROMs are built from source (.asm) at test time, so ignore
# all binaries, including our own. Bracket patterns catch any capitalisation.
*.[aA]26
*.[bB][iI][nN]
*.[rR][oO][mM]
*.[zZ][iI][pP]
*.7[zZ]
roms/
sim/roms/

# --- Simulation (Verilator) ---
obj_dir/
sim/out/
*.vcd
*.fst
*.wav

# --- Vivado ---
.Xil/
*.jou
*.log
*.str
vivado*.backup.*
*.bit
*.bit.hs

# --- Build output (mill / Chisel / prepared RTL) ---
build/
# rtl/ is generated by scripts/prepare_rtl.py for the framework build (our
# sources are in hdl/).
/rtl/
out/
.bsp/
.metals/
.bloop/
.idea/

# --- Python ---
__pycache__/
*.pyc
.venv/

# --- OS / editor ---
.DS_Store
*.swp

# --- Claude Code working files stay local (not published) ---
.claude/
CLAUDE.md
