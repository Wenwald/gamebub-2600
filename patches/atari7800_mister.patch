# Changes to Atari7800_MiSTer (vendored in third_party/atari7800_mister/,
# upstream 0dc8ad2e) for the 2600-only core. Applied by scripts/prepare_rtl.py
# to a copy in build/upstream/; the vendored files stay untouched. The
# patched file keeps its MIT notice.
#
# rtl/cart2600.sv:
#   - The NO_ARM_MAPPER guard now also covers the ARM front ends (stream
#     tables, RAM init, table writeback, ARM audio, DPC+, CDF, BUS), which
#     upstream instantiates outside it. With it set, those three schemes show
#     the "Out of Order" screen, as upstream's README describes for ARM games.
#   - 32-in-1: the game counter also clears when a new image starts loading,
#     so the first game is game 0 even when the scheme is already selected
#     (manually) during the load. Upstream cleared it only while another
#     scheme was selected.
#   - Supercharger (AR) and JANE are not supported (scripts/vendor_upstream.py
#     removes their mappers): like the ARM schemes they show the
#     unsupported-cartridge screen, and the AR tape outputs are tied off.
#
# rtl/TIA.sv, rtl/paddles.sv (Vivado 2026.1 synthesis, no behaviour change):
#   - TIA outputs i_out, col, lum, paddle_read, and paddles.sv's
#     paddle_select.select and paddle_timer.charged, become `output logic`:
#     they are assigned in always blocks, and an untyped output port is a
#     net, which Vivado rejects (Quartus and Verilator accept it).
#
--- a/rtl/cart2600.sv
+++ b/rtl/cart2600.sv
@@ -145,8 +145,16 @@
 
 	assign rom_mask = rom_size[18:0] - 1'd1;
 	assign rom_read = mapper == BANKAR ? ar_read : ~address_change;
+`ifdef NO_ARM_MAPPER
+	// Without the ARM, every Harmony/Melody ARM scheme is unsupported.
+	wire is_bad_game = mapper == BANKELF || mapper == BANKDPCP ||
+		mapper == BANKCDF || mapper == BANKBUS ||
+		mapper == BANKAR || mapper == BANKJANE;
+`else
 	wire is_bad_game = mapper == BANKELF ||
-		(mapper == BANKBUS && mapper_revision == 3'd0);
+		(mapper == BANKBUS && mapper_revision == 3'd0) ||
+		mapper == BANKAR || mapper == BANKJANE;
+`endif
 
 	// Handle unsupportable ARM mappers :(
 	spram #(
@@ -586,6 +594,7 @@
 	assign table_pointer_write_value = mapper == BANKCDF ?
 		cdf_pointer_update_value : bus_pointer_update_value;
 
+`ifndef NO_ARM_MAPPER
 	arm_mapper_tables stream_tables (
 		.clk_sys                (clk),
 		.family                 (table_family),
@@ -865,6 +874,83 @@
 		(mapper == BANKCDF ? cdf_call_stack : bus_call_stack);
 	assign arm_call_thumb = mapper == BANKDPCP ? dpc_call_thumb :
 		(mapper == BANKCDF ? cdf_call_thumb : bus_call_thumb);
+
+`else
+	// No ARM front ends: nothing initialises, streams, plays or calls, and
+	// the three ARM schemes show the unsupported screen (is_bad_game).
+	assign mapper_init_busy = 1'b0;
+	assign mapper_dma_request = 1'b0;
+	assign mapper_dma_fill = 1'b0;
+	assign mapper_dma_source = 25'd0;
+	assign mapper_dma_dest = 17'd0;
